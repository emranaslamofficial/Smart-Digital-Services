# Copy this file to ".env" and adjust the values.

# Server
PORT=3000
NODE_ENV=development
# Set to 1 when running behind a reverse proxy / hosting panel (Nginx, cPanel, Render, etc.)
TRUST_PROXY=0

# Public URL of the website (used for sitemap, canonical links, certificate verification links)
BASE_URL=http://localhost:3000

# First admin account (used ONLY when no admin exists yet). Password must be 10+ characters.
# If left empty, a one-time setup token is printed in the console and saved to data/setup-token.txt,
# and you create the admin at http://localhost:3000/admin/setup
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 64 hex characters (32 bytes). Encrypts CNIC numbers and the SMTP password at rest.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty, a key is generated automatically and stored in data/.data-key (back that file up!).
DATA_ENCRYPTION_KEY=

# Admin session lifetime
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12

# Optional custom storage locations
# DATA_DIR=./data
# UPLOAD_DIR=./uploads
